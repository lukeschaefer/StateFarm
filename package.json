  "directories": {
    "lib": "./lib",
    "src": "./src",
    "test": "./src"
  },
  "devDependencies": {
    "@eslint/js": "^9.12.0",
    "@types/chai": "^5.0.1",
    "@types/mocha": "latest",
    "assert": "^2.0.0",
    "chai": "^5.1.2",
    "eslint": "^9.12.0",
    "mocha": "latest",
    "rimraf": "^5.0.5",
    "ts-node": "^9.1.1",
    "tsx": "^4.19.2",
    "typescript": "^4.9.5",
    "typescript-eslint": "^8.8.1"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "keywords": [],
